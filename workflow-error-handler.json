        "message": "=<h2 style=\"color:#c0392b;\">⚠️ Workflow Failure Alert</h2>\n\n<table style=\"border-collapse:collapse; width:100%; font-family:Arial, sans-serif; font-size:14px;\">\n  <tr style=\"background:#f2f2f2;\">\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Workflow</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('LogError').item.json.workflow }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Failed Node</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('LogError').item.json.failed_node }}</td>\n  </tr>\n  <tr style=\"background:#f2f2f2;\">\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Error Message</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('LogError').item.json.error_message }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>HTTP Code</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('ExtractContext').item.json.http_code }}</td>\n  </tr>\n  <tr style=\"background:#f2f2f2;\">\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Severity</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('LogError').item.json.severity }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Affected Day</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('LogError').item.json.affected_day }}</td>\n  </tr>\n  <tr style=\"background:#f2f2f2;\">\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Execution URL</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">\n      <a href=\"{{ $('LogError').item.json.execution_url }}\">View Execution in n8n</a>\n    </td>\n  </tr>\n</table>\n\n<p style=\"margin-top:20px; font-size:12px; color:#888;\">\n  This alert was generated automatically by Workflow B (LinkedIn Error Handler).\n</p>",
        "options": {}
